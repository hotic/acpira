<!-- Loaded in JetBrains Client and monolith products; owns all UI and JCEF integrations. -->
<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="acpira.shared"/>
    </dependencies>

    <extensionPoints>
        <extensionPoint qualifiedName="com.github.hotic.acpira.browserProvider"
                        interface="com.github.hotic.acpira.web.BrowserProvider" dynamic="false"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Acpira" anchor="right" secondary="false" icon="/icons/toolWindow.svg"
                    factoryClass="com.github.hotic.acpira.ui.AcpiraToolWindowFactory"/>
        <fileEditorProvider implementation="com.github.hotic.acpira.ui.AcpiraEditorProvider"/>
        <editorTabTitleProvider implementation="com.github.hotic.acpira.ui.AcpiraTabTitle"/>
        <notificationGroup id="Acpira" displayType="BALLOON"/>
        <postStartupActivity implementation="com.github.hotic.acpira.DevAutoOpen"/>
    </extensions>

    <actions>
        <action id="Acpira.AddSelection" class="com.github.hotic.acpira.editor.AddSelectionAction"
                text="Add to Chat" description="Add the selected lines to the Acpira chat">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="com.github.hotic.acpira.WindowFocusRelay" topic="com.intellij.openapi.application.ApplicationActivationListener"/>
    </applicationListeners>
</idea-plugin>
