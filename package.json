{
  "name": "acpira-workspace",
  "version": "1.10.8",
  "description": "The Acpira repository: the Rust engine, the shared packages and every shell (apps/)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build:webview": "vite build --config packages/ui/vite.config.ts",
    "build:host": "node apps/vscode/build.mjs",
    "build:picker": "node packages/picker/build.mjs",
    "build": "pnpm build:host && pnpm build:picker && pnpm build:webview",
    "watch:host": "node apps/vscode/build.mjs --watch",
    "watch:picker": "node packages/picker/build.mjs --watch",
    "watch:webview": "vite build --config packages/ui/vite.config.ts --watch",
    "dev": "pnpm build && (pnpm watch:host & pnpm watch:picker & pnpm watch:webview & wait)",
    "typecheck": "tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "test": "vitest run",
    "probe": "tsx --tsconfig tsconfig.host.json scripts/acp-probe.ts",
    "harness": "cargo run --release --quiet --manifest-path rust/Cargo.toml --bin acpira -- --ws",
    "catalog:update": "cargo run --quiet --manifest-path rust/Cargo.toml --bin acpira -- model-catalog --out rust/crates/acpira-shared/assets/model-catalog.json",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "package": "pnpm build && pnpm build:sidecar && node scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/browser": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/vscode": "1.106.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vscode/vsce": "^3.9.2",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "border-beam": "1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "esbuild": "^0.28.2",
    "img-fx": "0.5.1",
    "katex": "0.16.47",
    "lucide-react": "1.35.0",
    "metal-fx": "1.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "smol-toml": "^1.8.0",
    "streamdown": "2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "thinking-orbs": "0.3.1",
    "three": "0.186.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@vscode/vsce-sign",
      "keytar"
    ]
  }
}
