{
  "name": "acpira",
  "displayName": "Acpira",
  "description": "Native harnesses, one considered interface: Grok Build, Kimi Code, Devin and any ACP agent CLI with execution history, inline approvals and shared sessions",
  "version": "1.3.0",
  "publisher": "hotic",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hotic/acpira.git"
  },
  "bugs": {
    "url": "https://github.com/hotic/acpira/issues"
  },
  "homepage": "https://github.com/hotic/acpira",
  "keywords": [
    "acp",
    "agent",
    "chat",
    "grok",
    "devin",
    "kimi",
    "cursor",
    "intellij"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acpira",
          "title": "Acpira",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "acpira": [
        {
          "type": "webview",
          "id": "acpira.chat",
          "name": "Acpira",
          "icon": "media/icon.svg",
          "contextualTitle": "Acpira",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "acpira.openView",
        "title": "%acpira.cmd.openView%",
        "category": "Acpira"
      },
      {
        "command": "acpira.newSession",
        "title": "%acpira.cmd.newSession%",
        "category": "Acpira",
        "icon": "$(add)"
      },
      {
        "command": "acpira.openInEditor",
        "title": "%acpira.cmd.openInEditor%",
        "category": "Acpira",
        "icon": "$(open-preview)"
      },
      {
        "command": "acpira.showLog",
        "title": "%acpira.cmd.showLog%",
        "category": "Acpira"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "acpira.newSession",
          "when": "view == acpira.chat",
          "group": "navigation@1"
        },
        {
          "command": "acpira.openInEditor",
          "when": "view == acpira.chat",
          "group": "navigation@2"
        },
        {
          "command": "acpira.showLog",
          "when": "view == acpira.chat"
        }
      ]
    },
    "configuration": {
      "title": "Acpira",
      "properties": {
        "acpira.defaultAgent": {
          "type": "string",
          "default": "grok",
          "description": "%acpira.conf.defaultAgent%"
        },
        "acpira.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "description": "%acpira.conf.language%"
        },
        "acpira.sessionScope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "enumDescriptions": [
            "%acpira.conf.sessionScope.workspace%",
            "%acpira.conf.sessionScope.all%"
          ],
          "default": "workspace",
          "description": "%acpira.conf.sessionScope%"
        },
        "acpira.agents": {
          "type": "object",
          "default": {},
          "markdownDescription": "%acpira.conf.agents%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "login": {
                "type": "string"
              },
              "install": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "docs": {
                    "type": "string"
                  }
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "acpira.compactAtTokens": {
          "type": "number",
          "default": 300000,
          "description": "%acpira.conf.compactAtTokens%"
        },
        "acpira.autoCompact": {
          "type": "boolean",
          "default": true,
          "description": "%acpira.conf.autoCompact%"
        },
        "acpira.hiddenOptions": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "%acpira.conf.hiddenOptions%",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "acpira.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "%acpira.conf.theme%"
        },
        "acpira.sessionListPosition": {
          "type": "string",
          "enum": ["hidden", "left", "right"],
          "default": "hidden",
          "description": "%acpira.conf.sessionListPosition%"
        },
        "acpira.uiFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 10,
          "maximum": 20,
          "description": "%acpira.conf.uiFontSize%"
        },
        "acpira.codeFontSize": {
          "type": "number",
          "default": 12,
          "minimum": 9,
          "maximum": 20,
          "description": "%acpira.conf.codeFontSize%"
        },
        "acpira.diffMarkers": {
          "type": "string",
          "enum": [
            "color",
            "signs"
          ],
          "default": "color",
          "description": "%acpira.conf.diffMarkers%"
        },
        "acpira.fontSmoothing": {
          "type": "boolean",
          "default": false,
          "description": "%acpira.conf.fontSmoothing%"
        },
        "acpira.appearance.density": {
          "type": "string",
          "enum": [
            "cozy",
            "compact",
            "airy"
          ],
          "default": "airy",
          "description": "%acpira.conf.appearance.density%"
        },
        "acpira.appearance.radius": {
          "type": "string",
          "enum": [
            "12",
            "8",
            "16"
          ],
          "default": "12",
          "description": "%acpira.conf.appearance.radius%"
        },
        "acpira.appearance.surface": {
          "type": "string",
          "enum": [
            "hairline",
            "tonal",
            "stroke"
          ],
          "default": "tonal",
          "description": "%acpira.conf.appearance.surface%"
        },
        "acpira.appearance.font": {
          "type": "string",
          "enum": [
            "system",
            "inter",
            "geist"
          ],
          "default": "inter",
          "description": "%acpira.conf.appearance.font%"
        },
        "acpira.appearance.userMessage": {
          "type": "string",
          "enum": [
            "bubble",
            "block",
            "plain"
          ],
          "default": "block",
          "description": "%acpira.conf.appearance.userMessage%"
        },
        "acpira.appearance.toolLine": {
          "type": "string",
          "enum": [
            "text",
            "icon",
            "rich"
          ],
          "default": "icon",
          "description": "%acpira.conf.appearance.toolLine%"
        },
        "acpira.appearance.thought": {
          "type": "string",
          "enum": [
            "text",
            "shimmer",
            "orb"
          ],
          "default": "orb",
          "description": "%acpira.conf.appearance.thought%"
        },
        "acpira.appearance.sessions": {
          "type": "string",
          "enum": [
            "dropdown",
            "drawer"
          ],
          "default": "dropdown",
          "description": "%acpira.conf.appearance.sessions%"
        },
        "acpira.appearance.composer": {
          "type": "string",
          "enum": [
            "island",
            "flush"
          ],
          "default": "island",
          "description": "%acpira.conf.appearance.composer%"
        },
        "acpira.appearance.beam": {
          "type": "string",
          "enum": [
            "line",
            "none",
            "pulse",
            "full"
          ],
          "default": "full",
          "description": "%acpira.conf.appearance.beam%"
        },
        "acpira.appearance.beamColor": {
          "type": "string",
          "enum": [
            "mono",
            "ocean",
            "colorful"
          ],
          "default": "mono",
          "description": "%acpira.conf.appearance.beamColor%"
        },
        "acpira.appearance.send": {
          "type": "string",
          "enum": [
            "accent",
            "icon",
            "metal"
          ],
          "default": "metal",
          "description": "%acpira.conf.appearance.send%"
        },
        "acpira.appearance.accent": {
          "type": "string",
          "enum": [
            "brand",
            "agent",
            "vscode"
          ],
          "default": "agent",
          "description": "%acpira.conf.appearance.accent%"
        },
        "acpira.appearance.motion": {
          "type": "string",
          "enum": [
            "on",
            "none"
          ],
          "default": "on",
          "description": "%acpira.conf.appearance.motion%"
        },
        "acpira.appearance.fold": {
          "type": "string",
          "enum": [
            "codex",
            "cursor"
          ],
          "default": "codex",
          "description": "%acpira.conf.appearance.fold%"
        }
      }
    }
  },
  "scripts": {
    "build:webview": "vite build --config vite.webview.config.ts",
    "build:host": "node esbuild.host.mjs",
    "build": "pnpm build:host && pnpm build:webview",
    "watch:host": "node esbuild.host.mjs --watch",
    "watch:webview": "vite build --config vite.webview.config.ts --watch",
    "dev": "pnpm build && (pnpm watch:host & pnpm watch:webview & wait)",
    "typecheck": "tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "test": "vitest run",
    "probe": "tsx --tsconfig tsconfig.host.json scripts/acp-probe.ts",
    "harness": "node dist/host-server.cjs --ws",
    "package": "pnpm build && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/vscode": "1.106.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vscode/vsce": "^3.9.2",
    "border-beam": "1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "esbuild": "^0.28.2",
    "katex": "0.16.47",
    "lucide-react": "1.35.0",
    "metal-fx": "1.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "smol-toml": "^1.8.0",
    "streamdown": "2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "thinking-orbs": "0.3.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@vscode/vsce-sign",
      "keytar"
    ]
  }
}
