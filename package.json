{
  "name": "acpira-workspace",
  "version": "2.0.0",
  "description": "The Acpira repository: the Rust engine, the shared packages and every shell (apps/)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build:webview": "pnpm --filter @acpira/ui build",
    "build:host": "pnpm --filter acpira build",
    "build:picker": "pnpm --filter @acpira/picker build",
    "build": "pnpm --filter acpira --filter @acpira/picker --filter @acpira/ui build",
    "watch:host": "pnpm --filter acpira watch",
    "watch:picker": "pnpm --filter @acpira/picker watch",
    "watch:webview": "pnpm --filter @acpira/ui watch",
    "dev": "pnpm build && (pnpm watch:host & pnpm watch:picker & pnpm watch:webview & wait)",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "probe": "tsx scripts/probe/acp.ts",
    "harness": "cargo run --release --quiet --manifest-path rust/Cargo.toml --bin acpira -- --ws",
    "catalog:update": "cargo run --quiet --manifest-path rust/Cargo.toml --bin acpira -- model-catalog --out rust/crates/acpira-shared/assets/model-catalog.json",
    "build:sidecar": "node scripts/release/build-sidecar.mjs",
    "version:set": "node scripts/release/set-version.mjs",
    "package": "node scripts/release/package-local.mjs",
    "package:vsix": "node scripts/release/package-local.mjs --vsix",
    "package:desktop": "node scripts/release/package-local.mjs --desktop",
    "install:local": "node scripts/release/install-local.mjs"
  },
  "devDependencies": {
    "@acpira/engine-client": "workspace:*",
    "@acpira/shared": "workspace:*",
    "@agentclientprotocol/sdk": "catalog:",
    "@base-ui/react": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "img-fx": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:",
    "streamdown": "catalog:",
    "three": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
