{
  "name": "acpira-desktop",
  "productName": "Acpira",
  "version": "1.10.8",
  "private": true,
  "description": "The Acpira desktop app: the chat webview and the Rust engine outside any IDE",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "icon": "node scripts/icon.mjs"
  },
  "devDependencies": {
    "@acpira/engine-client": "workspace:*",
    "@acpira/shared": "workspace:*",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "author": "hotic"
}
