{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acpira",
  "mainBinaryName": "Acpira",
  "version": "2.0.1",
  "identifier": "cc.hotic.acpira.desktop",
  "build": { "frontendDist": "stub" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "hotic",
    "shortDescription": "Chat with coding agent CLIs over ACP",
    "longDescription": "Native harnesses, one considered interface: Grok Build, Kimi Code, Devin, Codex, Claude and any ACP agent CLI with execution history, inline approvals and shared sessions",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png", "icons/128x128.png", "icons/256x256.png", "icons/512x512.png"],
    "resources": { "../../dist/webview/": "webview/", "../../dist/picker.js": "picker.js" },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": { "windowSize": { "width": 540, "height": 380 } }
    },
    "linux": {
      "deb": { "section": "devel", "desktopTemplate": "linux/Acpira.desktop" },
      "rpm": { "desktopTemplate": "linux/Acpira.desktop" },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
