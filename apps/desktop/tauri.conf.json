{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acpira",
  "mainBinaryName": "Acpira",
  "version": "1.10.8",
  "identifier": "com.hotic.acpira.desktop",
  "build": { "frontendDist": "stub" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "hotic",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": { "../../dist/webview/": "webview/", "../../dist/picker.js": "picker.js" },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": { "windowSize": { "width": 540, "height": 380 } }
    }
  }
}
