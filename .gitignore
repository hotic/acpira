# Dependencies
node_modules/

# Build
dist/
*.vsix
# Sidecar binary staged into a platform VSIX by scripts/release/package-vsix.mjs
/bin/

# Logs
*.log

# OS
.DS_Store

# Editor
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Internal docs (not published); docs/dev/ holds the committed agent guides indexed by AGENTS.md
docs/*
!docs/dev/
# Published docs: the context API other extensions call, the ChatGPT bridge, the agent compatibility matrix, the
# evaluation notes, the roadmap and the release guide
!docs/context-api.md
!docs/chatgpt-bridge.md
!docs/acp-agents-compat.md
!docs/harness-evaluations.md
!docs/roadmap.md
!docs/releasing.md

# Local agent skills
.agents/skills/

# Lab playground (local only): pages, the shared kit (lab/kit) and its Vite config
lab/

# Playwright scratch output
.playwright-cli/
output/

# JetBrains project files (the plugin source lives in apps/intellij/, its own .idea is ignored there)
.idea/

# iOS app (apps/ios/): per-user Xcode state, build output, SwiftPM state, fixtures exported from private sessions
xcuserdata/
*.xcuserstate
apps/ios/build/
apps/ios/Packages/.build/
apps/ios/Packages/*/.build/
apps/ios/Packages/*/.swiftpm/
# acpira-mobile's XCFramework and Swift bindings (apps/ios/scripts/build-net.sh)
apps/ios/Packages/AcpiraKit/Artifacts/
apps/ios/Fixtures/local/

# Promo films and source clips (local only)
promo/
