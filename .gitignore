# Dependencies
node_modules/

# Build
dist/
*.vsix
# Sidecar binary staged into a platform VSIX by scripts/package-vsix.mjs
/bin/

# Logs
*.log

# OS
.DS_Store

# Editor
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Internal docs (not published); docs/dev/ holds the committed agent guides indexed by AGENTS.md
docs/*
!docs/dev/

# Local agent skills
.agents/skills/

# Lab playground (local only)
lab/
src/lab/
vite.lab.config.ts

# Playwright scratch output
.playwright-cli/
output/

# JetBrains project files (the plugin source lives in idea/, its own .idea is ignored there)
.idea/

# iOS app (ios/): per-user Xcode state, build output, SwiftPM state, fixtures exported from private sessions
xcuserdata/
*.xcuserstate
ios/build/
ios/Packages/*/.build/
ios/Packages/*/.swiftpm/
ios/Fixtures/local/
